    }
  },
  "components": {
    "schemas": {
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the character"
          },
          "name": {
            "type": "string",
            "description": "Name of the character"
          },
          "species": {
            "type": "string",
            "description": "Species of the character"
          },
          "gender": {
            "type": "string",
            "description": "Gender of the character"
          },
          "age": {
            "type": "integer",
            "description": "Age of the character"
          },
          "height": {
            "type": "string",
            "description": "Height of the character"
          },
          "affiliation": {
            "type": "string",
            "description": "Character's affiliation or allegiance"
          },
          "occupation": {
            "type": "string",
            "description": "Character's occupation"
          },
          "status": {
            "type": "string",
            "description": "Current status of the character"
          }
        }
      },
      "Episode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the episode"
          },
          "title": {
            "type": "string",
            "description": "Title of the episode"
          },
          "season": {
            "type": "integer",
            "description": "Season number"
          },
          "episodeNumber": {
            "type": "integer",
            "description": "Episode number within the season"
          },
          "airDate": {
            "type": "string",
            "format": "date",
            "description": "Air date of the episode"
          },
          "description": {
            "type": "string",
            "description": "Synopsis or description of the episode"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the location"
          },
          "name": {
            "type": "string",
            "description": "Name of the location"
          },
          "region": {
            "type": "string",
            "description": "Region where the location is situated"
          },
          "description": {
            "type": "string",
            "description": "Description of the location"
          },
          "significance": {
            "type": "string",
            "description": "Significance of the location in the series"
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the organization"
          },
          "name": {
            "type": "string",
            "description": "Name of the organization"
          },
          "type": {
            "type": "string",
            "description": "Type or classification of the organization"
          },
          "allegiance": {
            "type": "string",
            "description": "Allegiance of the organization"
          },
          "description": {
            "type": "string",
            "description": "Description of the organization"
          },
          "leader": {
            "type": "string",
            "description": "Leader of the organization"
          }
        }
      },
      "Titan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the titan"
          },
          "name": {
            "type": "string",
            "description": "Name of the titan",
            "example": "Attack Titan"
          },
          "height": {
            "type": "string",
            "description": "Height of the titan",
            "example": "15m"
          },
          "currentInheritor": {
            "type": "string",
            "description": "Current inheritor of the titan",
            "example": "Eren Jaeger"
          },
          "allegiance": {
            "type": "string",
            "description": "Allegiance of the titan or its inheritor",
            "example": "Eldia"
          },
          "abilities": {
            "type": "array",
            "description": "List of abilities possessed by the titan",
            "items": {
              "type": "string"
            },
            "example": [
              "Future memory inheritance",
              "Hardening"
            ]
          },
          "formerInheritors": {
            "type": "array",
            "description": "List of former inheritors",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Characters",
      "description": "Operations related to Attack on Titan characters"
    },
    {
      "name": "Episodes",
      "description": "Operations related to Attack on Titan episodes"
    },
    {
      "name": "Locations",
      "description": "Operations related to Attack on Titan locations"
    },
    {
      "name": "Organizations",
      "description": "Operations related to Attack on Titan organizations"
    },
    {
      "name": "Titans",
      "description": "Operations related to Attack on Titan titans"
    }
  ]
}
