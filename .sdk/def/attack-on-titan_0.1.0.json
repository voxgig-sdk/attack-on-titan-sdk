        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the titan to retrieve",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Titan details",
            "content": {
