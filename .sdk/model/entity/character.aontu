      sh: "Current status of the character"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /characters"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/characters"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "characters"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /characters/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/characters/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "characters"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
