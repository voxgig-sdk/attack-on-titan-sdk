# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: {
    affiliation: {
      h: "Affiliation"
      n: "affiliation"
      r: false
      sh: "Character's affiliation or allegiance"
      t: "`$STRING`"
    }
    age: {
      h: "Age"
      n: "age"
      r: false
      sh: "Age of the character"
      t: "`$INTEGER`"
    }
    gender: {
      h: "Gender"
      n: "gender"
      r: false
      sh: "Gender of the character"
      t: "`$STRING`"
    }
    height: {
      h: "Height"
      n: "height"
      r: false
      sh: "Height of the character"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the character"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the character"
      t: "`$STRING`"
    }
    occupation: {
      h: "Occupation"
      n: "occupation"
      r: false
      sh: "Character's occupation"
      t: "`$STRING`"
    }
    species: {
      h: "Species"
      n: "species"
      r: false
      sh: "Species of the character"
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
