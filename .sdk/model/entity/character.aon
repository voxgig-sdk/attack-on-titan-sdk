# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: [
    {
      name: "affiliation"
      req: false
      short: "Character's affiliation or allegiance"
      type: "`$STRING`"
    }
    {
      name: "age"
      req: false
      short: "Age of the character"
      type: "`$INTEGER`"
    }
    {
      name: "gender"
      req: false
      short: "Gender of the character"
      type: "`$STRING`"
    }
    {
      name: "height"
      req: false
      short: "Height of the character"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the character"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the character"
      type: "`$STRING`"
    }
    {
      name: "occupation"
      req: false
      short: "Character's occupation"
      type: "`$STRING`"
    }
    {
      name: "species"
      req: false
      short: "Species of the character"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the character"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/characters"
          parts: [
            "characters"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/characters/{id}"
          parts: [
            "characters"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
